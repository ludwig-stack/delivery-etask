# Server-only configuration. Never prefix these with NEXT_PUBLIC_.
# Use approved production accounts, not the development accounts.
SESSION_SECRET=
AUTH_USERS_JSON=[]

# Required for Vercel: an existing initialized Cloudflare D1 database.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_API_TOKEN=

# Optional LOCAL SQLite override; never used on Vercel.
# DSI_SQLITE_PATH=.data/delivery.sqlite
