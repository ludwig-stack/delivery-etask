# Server-only connection to the Cloudflare Worker bound to the D1 database.
# Use http://127.0.0.1:8787 for local Wrangler development.
D1_WORKER_URL=
# At least 32 random characters; set the same secret on the database Worker.
# Never prefix this secret with NEXT_PUBLIC_.
D1_WORKER_SECRET=
# Set to 0.0.0.0 inside a container; otherwise use a local HTTPS reverse proxy.
DSI_BIND_ADDRESS=127.0.0.1
PORT=3000

# Existing app accounts and signed sessions (independent of Supabase Auth).
SESSION_SECRET=
AUTH_USERS_JSON=[]
