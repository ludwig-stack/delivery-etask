# Local file database. Use an absolute path on a persistent production volume.
DSI_DATA_PATH=.data/delivery.sqlite
# Set to 0.0.0.0 inside a container; otherwise use a local HTTPS reverse proxy.
DSI_BIND_ADDRESS=127.0.0.1
PORT=3000

# Server-only authentication. Never prefix secrets with NEXT_PUBLIC_.
SESSION_SECRET=
AUTH_USERS_JSON=[]
